# Application
APP_NAME=HHGoa-RAG
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# STT Provider (Phase 9)
SARVAM_API_KEY=

# LLM Provider (Phase 6 — provider-agnostic interface)
LLM_PROVIDER=mock # options: mock, groq, openai, gemini
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Embeddings (Phase 3 — model selected via benchmarks)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Vector Database
VECTOR_DB_PATH=data/indexes

